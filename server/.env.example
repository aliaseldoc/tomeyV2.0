PORT=3001
# Orígenes permitidos para CORS, separados por coma (sin barra final).
FRONTEND_ORIGIN=http://localhost:5173,https://<usuario>.github.io
# Connection string de tu cluster de MongoDB Atlas (incluye el nombre de la base al final, ej: /tomey).
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/tomey
